# FortyGuard API Configuration
# Get your free API key at https://dashboard.fortyguard.com/
# Free tier: 1,000,000 credits/month
NEXT_PUBLIC_FORTYGUARD_API_KEY=your_api_key_here
NEXT_PUBLIC_FORTYGUARD_BASE_URL=https://api.fortyguard.com/v1

# OSRM Routing (free, no key needed)
NEXT_PUBLIC_OSRM_BASE_URL=https://router.project-osrm.org

# Map Configuration — USA ONLY (CONUS + AK/HI)
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
NEXT_PUBLIC_DEFAULT_CENTER_LAT=33.4484
NEXT_PUBLIC_DEFAULT_CENTER_LNG=-112.0740
NEXT_PUBLIC_DEFAULT_ZOOM=13
NEXT_PUBLIC_RESTRICT_TO_USA=true

# App Configuration - LIVE ONLY (no demo)
NEXT_PUBLIC_APP_NAME=CoolRoutes
NEXT_PUBLIC_APP_DESCRIPTION=Heat-safe navigation for vulnerable populations (USA only) - Live FortyGuard only